# BC Wallet - Production
# Reverts the bcsc-dev project default back to the BC Wallet configuration.

APP_NAME='BC Wallet'
APP_VERSION='1.0.28'
BUILD_TARGET='bcwallet'
DEFAULT_ENVIRONMENT='PROD'

# Android
ANDROID_PACKAGE_NAME='ca.bc.gov.BCWallet'
ANDROID_ICON_REF='ic_launcher'

# iOS
IOS_BUNDLE_ID='ca.bc.gov.BCWallet'
IOS_PRODUCT_NAME='BCWallet'

# URL schemes (comma-separated). BC Wallet registers only the bcwallet and
# didcomm schemes; these overwrite the bcsc schemes from the project default.
IOS_URL_SCHEMES='bcwallet,didcomm'
ANDROID_URL_SCHEMES='didcomm,bcwallet'

# iOS signing / distribution
IOS_EXPORT_METHOD='app-store'

# Android signing / distribution
ANDROID_JKS_BASE64_SECRET='PLAY_STORE_JKS_BASE64'
ANDROID_JKS_ALIAS_SECRET='PLAY_STORE_JKS_ALIAS'
ANDROID_JKS_PASSWD_SECRET='PLAY_STORE_JKS_PASSWD'

# SauceLabs
SAUCE_LABS_PREFIX='BCWallet'

# Firebase App Distribution service accounts
FIREBASE_IOS_SA_REF='op://bcsc-mobile-app-cd/firebase-sa-bcwallet/service-account.json'
FIREBASE_ANDROID_SA_REF='op://bcsc-mobile-app-cd/firebase-sa-bcwallet/service-account.json'
