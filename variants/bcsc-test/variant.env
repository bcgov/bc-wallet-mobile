# BCSC - Test
APP_NAME='BC Services Card'
APP_VERSION='4.1.0'
BUILD_TARGET='bcsc'
DEFAULT_ENVIRONMENT='TEST'

# Android
ANDROID_PACKAGE_NAME='ca.bc.gov.id.servicescard.test'
ANDROID_ICON_REF='ic_launcher'

# iOS
IOS_BUNDLE_ID='ca.bc.gov.idtest.servicescard'
IOS_PRODUCT_NAME='$(TARGET_NAME)'

# URL schemes (comma-separated). 'bcwallet' and 'didcomm' are retained alongside
# the servicescard schemes so connection-invitation deep links open this build
# (e.g. bcwallet://aries_connection_invitation?oob=... or didcomm://...?oob=...).
IOS_URL_SCHEMES='ca.bc.gov.idtest.servicescard,ca.bc.gov.idtest.servicescard.v2,bcwallet,didcomm'
ANDROID_URL_SCHEMES='ca.bc.gov.id.servicescard.test,ca.bc.gov.idtest.servicescard.v2,bcwallet,didcomm'

# Base variant to inherit shared assets from
BASE_VARIANT='_bcsc-base'

# iOS signing / distribution
IOS_EXPORT_METHOD='app-store'
IOS_PROVISIONING_PROFILE_SECRET='BUILD_PROVISION_PROFILE_SATEST_BASE64'

# Android signing / distribution
ANDROID_JKS_BASE64_SECRET='PLAY_STORE_JKS_BASE64_SATEST'
ANDROID_JKS_ALIAS_SECRET='PLAY_STORE_JKS_ALIAS_SATEST'
ANDROID_JKS_PASSWD_SECRET='PLAY_STORE_JKS_PASSWD_SATEST'

# SauceLabs
SAUCE_LABS_PREFIX='BCSC-Test'

# TestFlight beta groups (newline-separated)
TESTFLIGHT_BETA_GROUPS='IDIM testers for TEST env'

# Firebase App Distribution & tester groups (comma-separated)
FIREBASE_IOS_SA_REF='op://bcsc-mobile-app-cd/firebase-sa-bcsc-ios/service-account.json'
FIREBASE_ANDROID_SA_REF='op://bcsc-mobile-app-cd/firebase-sa-bcsc-android/service-account.json'
FIREBASE_IOS_TESTER_GROUPS='ring-0'
FIREBASE_ANDROID_TESTER_GROUPS='ring-0'
