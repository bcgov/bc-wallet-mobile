+  // PATCH (bc-wallet-mobile): run session mutations only after the main queue has drained what was
+  // already pending. React Native mounts and unmounts the preview view on the main queue, and while a
+  // preview layer is attached AVFoundation blocks on the main thread inside stopRunning and
+  // commitConfiguration (9 s timeout on iOS 26, none on iOS 18). If the main thread is then inside
+  // CoreAnimation's layerDidBecomeVisible: (called with the CA tree lock held) waiting for the session
+  // lock, the app hangs for good; every <Camera> unmount used to race this. Ordering the mutation after
+  // the pending main-thread work keeps the two from overlapping without ever blocking the main thread.
+  private static func afterMainOnSessionQueue<T>(_ run: @escaping @Sendable () throws -> T) -> Promise<T> {
+    let promise = Promise<T>()
+    DispatchQueue.main.async {
+      Self.queue.async {
+        do {
+          promise.resolve(withResult: try run())
+        } catch {
+          promise.reject(withError: error)
+        }
+      }
+    }
+    return promise
+  }
