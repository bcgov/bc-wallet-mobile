# E2E environment variables (general — all run targets)
# Copy to .env.e2e and edit with your values:
#   cp .env.e2e.example .env.e2e
#
# Loaded automatically by wdio.shared.conf.ts for every run target
# (local sim/emu, real device, and SauceLabs).

# --- Variant ---
VARIANT=bcsc # bcsc or bc-wallet

# --- iOS (local sim) ---
IOS_DEVICE=iPhone 16
IOS_VERSION=18.5
IOS_APP=BCSC.app # BCSC.app or BCWallet.app

# --- iOS real device only ---
# Device config uses IOS_APP_DEVICE (default BCWallet.ipa), not IOS_APP, so sim .app is not used on device
IOS_APP_DEVICE=BCSC.ipa # BCSC.ipa or BCWallet.ipa
IOS_UDID=XXXXXXXXXXXXXXXXXXXXXXXXXX
XCODE_ORG_ID=XXXXXXXXXX
# Quote the value (spaces). iPhone Developer / iPhone-Developer conflicts with WDA automatic signing on Xcode 15+.
XCODE_SIGNING_ID="Apple Development"
SHOW_XCODE_LOG=false

# --- Android (local emu/device) ---
# Use a version that matches your emulator (e.g. 15 for API 35). Leave unset to use config default (15.0).
ANDROID_DEVICE=Pixel_7
ANDROID_VERSION=15
ANDROID_APP=BCSC.apk # BCSC.apk or BCWallet.apk

# --- Android real device only ---
ANDROID_UDID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Appium (optional) ---
# APPIUM_HOME=/custom/path/to/appium
NO_RESET=false

# --- E2E issuer (wallet credential journey) ---
# The runner-driven issuer/verifier — a Traction dev tenant (src/api/issuer.ts, issuer/README.md).
# One-time `yarn issuer:provision` publishes the schema/cred def and writes issuer/.issuer-env
# (ids only — explicit env vars override it). CI loads the credentials from 1Password
# (op://bcsc-mobile-app-cd/traction) — see e2e.yml.
# ISSUER_TENANT_ID=
# ISSUER_API_KEY=
# ISSUER_BASE_URL=https://traction-tenant-proxy-dev.apps.silver.devops.gov.bc.ca

# --- IDCheck portal sign-in (in-person approval, send-video review, queue drain) ---
# Used by scripts/login.mjs (via src/helpers/approval.ts) to sign in to the IDCheck SIT
# portal, which authenticates through BC Gov SSO + Entra ID (IDIR - MFA). The sign-in runs
# in a headless Chrome (Google Chrome if installed, else `yarn playwright-core install chromium`);
# everything after it is plain HTTP. The account needs the IDIM Verification Specialist role.
# Required for suites with in-person verification or send-video review; omit for smoke runs.
# In CI these come from 1Password (the bcsc-ias-test-account item) — see e2e.yml.
# The Entra sign-in name = the account's gov email (for the IAS test account, that item's "email" field).
IDCHECK_USER=you@gov.bc.ca
IDCHECK_PASSWORD=your-idir-password
# Base32 secret of the account's authenticator ("software token") MFA method — the same seed 1Password
# uses to render the live code. Required for unattended runs (CI). Omit locally to approve the Microsoft
# Authenticator push on your phone instead — the number to match is logged.
# IDCHECK_TOTP_SECRET=
# Watch the sign-in in a visible browser (selector drift, screenshots).
# IDCHECK_LOGIN_HEADED=1
# Anti-lockout knobs (defaults are fine): where the persistent browser profile + sign-in ledger live,
# how many real Entra rejections latch the run, and the reset switch. Delete the profile dir to force a
# fresh MFA challenge.
# IDCHECK_STATE_DIR=~/.idcheck-e2e
# IDCHECK_PROFILE_DIR=~/.idcheck-e2e/profile
# IDCHECK_MFA_MAX_FAILURES=3
# IDCHECK_AUTH_RESET=1

# --- IAS E2E Test API (minted identities, agent decisions) ---
# The runner's client for IAS's non-production test API (src/api/ias-test.ts). IAS issued one OAuth 2.0
# client per environment; both are in 1Password (bcsc-mobile-app-cd: ias-test-api-dev and
# ias-test-api-sit; username = client id, credential = client secret, hostname = host). CI loads the SIT
# item, see e2e.yml. Check the values with `yarn test-api:check`.
IAS_TEST_API_HOST=idsit.gov.bc.ca # idsit.gov.bc.ca (SIT) or iddev.gov.bc.ca (DEV)
IAS_TEST_API_CLIENT_ID=mobile.e2e.test.client.sit # mobile.e2e.test.client.dev on DEV
# IAS_TEST_API_CLIENT_SECRET=

# Where a journey's card holder comes from: personas (the default, the fixed SIT personas) or api (a
# card minted for each session through the test API above, on the environment its host names, which
# must be the one the app is on). CI does not set it.
# E2E_IDENTITY_SOURCE=api

# Who approves an in-person request: idcheck (the default, the ID Check portal replay) or api (one call
# to the test API above, keyed by the confirmation code). api needs a host that serves the decision
# route, which `yarn test-api:check` reports. CI does not set it.
# E2E_APPROVAL_SOURCE=api
